{
  "name": "site1",
  "main": "worker.js",
  "compatibility_date": "2026-09-11",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "manutd.wiki", "custom_domain": true },
    { "pattern": "www.manutd.wiki", "custom_domain": true }
  ],
  "kv_namespaces": [
    { "binding": "MU_CACHE", "id": "d1d3669e50bd4a61aeec70e94738fc30" }
  ],
  "triggers": {
    "crons": ["7 * * * *", "* * * * *"]
  },
  "observability": {
    "enabled": true
  },
  "env": {
    // dev.manutd.wiki: a second Worker built from the `redesign` branch (deploy command `npx wrangler deploy --env dev`).
    // Pages are served from this build; every data call (/api, /wiki*, /push, /collection, /feed, /img, /cover) is proxied
    // to the live site, so this Worker has no API key, no KV and no crons — it cannot send alerts or write anything itself.
    "dev": {
      "name": "site1-dev",
      "routes": [{ "pattern": "dev.manutd.wiki", "custom_domain": true }],
      "vars": { "UPSTREAM": "https://manutd.wiki" },
      "kv_namespaces": [],
      "triggers": { "crons": [] }
    }
  }
}
