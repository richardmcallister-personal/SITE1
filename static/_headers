/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https: ; media-src https:; style-src 'self'; script-src 'none'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'

/style.css
  Cache-Control: public, max-age=3600

# /should-i-go/ is a standalone app (inline JS/CSS, Google Fonts, Open-Meteo weather, 3D Digital Venue seat view).
# It needs a looser policy than the rest of the site; scoped to this path only.
/manutd/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https: ; media-src https:; connect-src 'self' https://api.open-meteo.com https://api.frankfurter.app https://en.wikipedia.org https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://cloudflareinsights.com; frame-src https://preview.3ddigitalvenue.com https://www.youtube.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'

/should-i-go/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'
